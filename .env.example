NODE_ENV=development
PORT=3000
APP_HOST=0.0.0.0
# http: local/SSH/VPN or behind a TLS reverse proxy; https: direct TLS; mtls: direct TLS with client certificates.
APP_TRANSPORT=http
# Comma-separated proxy IPs or CIDRs. Leave empty unless a trusted reverse proxy terminates TLS.
APP_TRUST_PROXY=
APP_TLS_CERT_PATH=
APP_TLS_KEY_PATH=
APP_TLS_CLIENT_CA_PATH=
APP_TLS_KEY_PASSPHRASE_PATH=
LOG_LEVEL=info
REVOLUT_MODE=mock
REVOLUT_BASE_URL=https://sandbox-b2b.revolut.com/api/1.0
REVOLUT_SANDBOX_CONFIG_PATH=/run/secrets/revolut-sandbox-config
REVOLUT_SANDBOX_TOKENS_PATH=/run/secrets/revolut-sandbox-tokens
REVOLUT_SANDBOX_PRIVATE_KEY_PATH=/run/secrets/revolut-sandbox-private-key
OPERATOR_AUTH_CONFIG_PATH=/run/secrets/operator-auth-config
OPERATOR_COOKIE_SECURE=false
SANDBOX_INTERNAL_TRANSFER_MAX_MINOR=1000
# Case workflow only (Sandbox): currency-to-maximum map in integer minor units. USD 1,000,000,000 = 100000000000 cents.
CASE_SANDBOX_MAXIMUMS_JSON={"USD":100000000000}
SANDBOX_DATABASE_PATH=/var/lib/revolut/sandbox-transfers.sqlite
BROKERED_FUNDING_ENABLED=true
CASE_EVIDENCE_ROOT=/var/lib/revolut/evidence
# Optional: 32 random bytes in base64. If omitted, a protected key is generated on the evidence volume.
CASE_EVIDENCE_KEY_BASE64=
# JSON object mapping source key IDs to Ed25519 PEM public keys.
CASE_TRUSTED_SOURCE_KEYS_JSON={}
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
REVOLUT_CLIENT_ID=
REVOLUT_ISSUER=https://your-domain.example
REVOLUT_PRIVATE_KEY_PATH=/run/secrets/revolut-private.pem
REVOLUT_REFRESH_TOKEN=
REVOLUT_WEBHOOK_SIGNING_SECRET=
PAYMENT_MAX_AMOUNT_MINOR=100000000
PAYMENT_ALLOWED_CURRENCIES=EUR,GBP,CHF,USD
PAYMENT_REQUIRE_NAME_MATCH=true
ISO20022_MAX_FILE_BYTES=2000000
ISO20022_MAX_TRANSACTIONS=100
ISO20022_MAX_XML_ELEMENTS=20000
ISO20022_MAX_XML_DEPTH=64
ISO20022_STRUCTURED_ADDRESS_CUTOFF=2026-11-15
