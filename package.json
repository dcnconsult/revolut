{
  "name": "revolute-business-api",
  "version": "0.3.0",
  "private": true,
  "description": "Bank-to-bank payment orchestration with manual and ISO 20022 XML ingestion for the Revolut Business API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:console": "vite --config vite.config.ts",
    "build": "npm run build:server && npm run build:console",
    "build:server": "tsc -p tsconfig.json",
    "build:console": "vite build --config vite.config.ts",
    "start": "node dist/src/server.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.frontend.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "operator:credentials": "node scripts/operator/create-credentials.mjs",
    "test:e2e": "playwright test",
    "test:iso20022": "vitest run --config vitest.config.ts tests/iso20022-parser.test.ts tests/iso20022-routes.test.ts",
    "sandbox:setup": "node scripts/sandbox/setup.mjs",
    "sandbox:accounts": "node scripts/sandbox/accounts.mjs",
    "sandbox:droplet-check": "node scripts/sandbox/droplet-accounts.mjs",
    "sandbox:topup": "node scripts/sandbox/topup.mjs",
    "sandbox:simulate": "node scripts/sandbox/simulate-transfer.mjs",
    "sandbox:transfer": "node scripts/sandbox/account-transfer.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/sensible": "^6.0.2",
    "@fastify/static": "^10.1.2",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.2.1",
    "jose": "^6.0.8",
    "pino": "^9.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.6"
  },
  "packageManager": "npm@10.9.2"
}
